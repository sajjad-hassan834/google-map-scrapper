# MapLead Application Environment Configuration
# Copy this to ".env" and set your values:  cp .env.example .env

# ==========================================
# Authentication & Security (Required on host)
# ==========================================
# The master application password to unlock MapLead
APP_PASSWORD=your_secure_password_here

# Secret key used to sign 7-day session cookies (generate with `openssl rand -hex 32`)
SESSION_SECRET=your_32_byte_session_secret_hex_here

# ==========================================
# Google Places API (New)
# ==========================================
# Google Cloud Places API (New) Text Search Enterprise SKU key
PLACES_API_KEY=

# ==========================================
# Deep Search (Local Scraper)
# ==========================================
SCRAPER_BASE_URL=http://localhost:8080
SCRAPER_API_KEY=

# ==========================================
# Optional Brand Customization
# ==========================================
APP_NAME=MapLead
APP_TAGLINE=Find local businesses that need a website
